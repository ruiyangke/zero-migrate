# Rust build output
/target
**/target

# Node / napi
node_modules/
*.node
dist-node/
crates/zero-migrate-node/package-lock.json
# NOTE: pnpm-lock.yaml is intentionally TRACKED (not ignored) so CI's
# `actions/setup-node` pnpm cache + `pnpm install --frozen-lockfile` work.

# Derived TS build output (tsup/tsc). The ONLY tracked dist artifact is the
# engine-embedded recorder (`include_str!`'d by the crate); everything else under
# dist/ is regenerated by `pnpm build`.
packages/*/dist/
!packages/zero-migrate/dist/
packages/zero-migrate/dist/*
!packages/zero-migrate/dist/embedded-recorder.js

# napi build artifacts. The generated `index.js` (platform-resolving loader) and
# `index.d.ts` (the typed ABI surface, the single source of truth the engine's
# addon.ts imports) ARE tracked: they let any checkout typecheck/build without a
# Rust toolchain, and are the published entry of the `zero-migrate-node` package.
# Only the compiled `.node` binaries are per-platform build output.
crates/zero-migrate-node/*.node
# The per-platform npm/<triple>/ dirs are regenerated at release time by
# `napi create-npm-dirs`; do not track them.
crates/zero-migrate-node/npm/

# OS / editor
.DS_Store
*.swp
